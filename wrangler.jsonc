{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "campus-auth-website",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "amiya.cc/*", "zone_name": "amiya.cc" },
    { "pattern": "www.amiya.cc/*", "zone_name": "amiya.cc" }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
